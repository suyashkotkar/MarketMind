# Copy to .env and adjust. Nothing here is required to run locally.

# --- app ---
ENV=development
LOG_LEVEL=INFO
# Trained models + the SQLite dev DB. Mount this as a volume in production.
ARTIFACTS_DIR=./artifacts

# --- database ---
# Postgres in Docker / production:
# DATABASE_URL=postgresql+psycopg2://stockseer:stockseer@localhost:5432/stockseer
# SQLite keeps local dev zero-setup:
DATABASE_URL=sqlite:///./artifacts/stockseer.db

# --- data source ---
# yahoo    = live Yahoo Finance via yfinance (default)
# synthetic = deterministic offline generator; use it in CI, on a plane, or
#             anywhere outbound network access is blocked
DATA_SOURCE=yahoo
HISTORY_PERIOD=5y

# auto | yahoo | newsapi | finnhub | synthetic | none
NEWS_SOURCE=auto
NEWSAPI_KEY=
FINNHUB_KEY=

DEFAULT_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,XOM,JNJ
BENCHMARK_TICKER=SPY

# --- modelling ---
HORIZON_DAYS=5
EMBARGO_DAYS=5
N_SPLITS=5
MODEL_TYPE=lightgbm         # lightgbm | xgboost | gbdt
LONG_THRESHOLD=0.55
SHORT_THRESHOLD=0.45

# --- risk / anomalies ---
VAR_CONFIDENCE=0.95
RISK_LOOKBACK=252
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_CONTAMINATION=0.02

# --- api ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CACHE_TTL_SECONDS=300
